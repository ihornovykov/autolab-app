{
  "name": "autolab",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:push": "vp run --filter @autolab/db db:push",
    "db:studio": "vp run --filter @autolab/db db:studio",
    "db:generate": "vp run --filter @autolab/db db:generate",
    "db:migrate": "vp run --filter @autolab/db db:migrate",
    "db:seed": "vp run --filter @autolab/db db:seed",
    "db:seed-stress": "vp run --filter @autolab/db db:seed-stress",
    "db:seed-working-hours": "vp run --filter @autolab/db db:seed-working-hours"
  },
  "dependencies": {
    "@autolab/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@autolab/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "rolldown": "1.1.0",
    "typescript": "catalog:",
    "vite-plus": "0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:"
    }
  }
}
